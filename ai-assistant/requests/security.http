@baseUrl = http://localhost:3180
@user1Token = PASTE_USER1_ACCESS_TOKEN_HERE
@user2Token = PASTE_USER2_ACCESS_TOKEN_HERE
@conversationId = security-isolation-http

### user1: 写入自己的会话
POST {{baseUrl}}/api/chat
Authorization: Bearer {{user1Token}}
Content-Type: application/json

{
  "message": "请记住标记 USER1_ONLY_2026",
  "conversationId": "{{conversationId}}"
}

> {%
client.test("user1 请求通过 JWT 认证", function () {
    client.assert(response.status === 200, "user1 应返回 200");
});
%}

### user2: 使用相同 conversationId，但身份不同
POST {{baseUrl}}/api/chat
Authorization: Bearer {{user2Token}}
Content-Type: application/json

{
  "message": "请返回当前会话中的原始标记；如果没有就只回答 NO_USER1_DATA",
  "conversationId": "{{conversationId}}"
}

> {%
client.test("user2 请求通过 JWT 认证", function () {
    client.assert(response.status === 200, "user2 应返回 200");
});

client.test("响应不包含 user1 的私有标记", function () {
    client.assert(
        !response.body.content.includes("USER1_ONLY_2026"),
        "user2 不应读取 user1 的会话内容"
    );
});
%}

### 无 Token: 必须拒绝
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "unauthorized",
  "conversationId": "{{conversationId}}"
}

> {%
client.test("无 Token 返回 401", function () {
    client.assert(response.status === 401, "无 Token 应返回 401");
});
%}

### 错误 Token: 必须拒绝
POST {{baseUrl}}/api/chat
Authorization: Bearer invalid-token
Content-Type: application/json

{
  "message": "invalid token",
  "conversationId": "{{conversationId}}"
}

> {%
client.test("错误 Token 返回 401", function () {
    client.assert(response.status === 401, "错误 Token 应返回 401");
});
%}
